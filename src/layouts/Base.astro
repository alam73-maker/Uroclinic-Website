---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-700.css';
import '../styles/global.css';
import '../styles/hx.css';
import Brand from '../components/Brand.astro';
import { clinicJsonLd, socialLinks } from '../content/doctor';
import { dir, href, altHref, ui, type Lang } from '../i18n/ui';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import plexUrl from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';

interface Props { lang: Lang; path?: string; title?: string; description?: string; noindex?: boolean; bare?: boolean }
const { lang, path = '', title, description, bare = false, noindex = false } = Astro.props;
const t = ui[lang];
const ICONS: Record<string, string> = {"Facebook": "<path d=\"M14 8.5V6.8c0-.8.5-1 .9-1H17V2.2L14.1 2C11 2 10.3 4.3 10.3 5.9v2.6H8v3.7h2.3V22H14v-9.8h2.8l.4-3.7H14z\"/>", "Instagram": "<path d=\"M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zM21.9 7.9c-.1-1.6-.4-3-1.6-4.2S17.7 2.2 16.1 2.1C14.5 2 9.5 2 7.9 2.1 6.3 2.2 4.9 2.5 3.7 3.7S2.2 6.3 2.1 7.9C2 9.5 2 14.5 2.1 16.1c.1 1.6.4 3 1.6 4.2s2.6 1.5 4.2 1.6c1.6.1 6.6.1 8.2 0 1.6-.1 3-.4 4.2-1.6s1.5-2.6 1.6-4.2c.1-1.6.1-6.6 0-8.2zm-2.1 10a3.3 3.3 0 0 1-1.9 1.9c-1.3.5-4.4.4-5.9.4s-4.6.1-5.9-.4a3.3 3.3 0 0 1-1.9-1.9c-.5-1.3-.4-4.4-.4-5.9s-.1-4.6.4-5.9a3.3 3.3 0 0 1 1.9-1.9c1.3-.5 4.4-.4 5.9-.4s4.6-.1 5.9.4a3.3 3.3 0 0 1 1.9 1.9c.5 1.3.4 4.4.4 5.9s.1 4.6-.4 5.9z\"/>", "TikTok": "<path d=\"M16.6 2h-3.3v13.4a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.2a6.3 6.3 0 1 0 5.3 6.2V8.6a7.9 7.9 0 0 0 4.4 1.4V6.6A4.5 4.5 0 0 1 16.6 2z\"/>"};
const pageTitle = title ? `${title} | ${t.titleSuffix}` : t.titleSuffix;
const current = href(lang, path);
const links = [
  { label: t.nav.home, to: href(lang, '') },
  { label: t.nav.about, to: href(lang, 'about') },
  { label: t.nav.stories, to: href(lang, 'patient-stories') },
  { label: t.nav.research, to: href(lang, 'research') },
];
---

<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#17324d" />
    {(noindex || bare) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={`https://www.osmanuroclinic.com${current}`} />
    <link rel="alternate" hreflang="ar" href={`https://www.osmanuroclinic.com${href('ar', path)}`} />
    <link rel="alternate" hreflang="en" href={`https://www.osmanuroclinic.com${href('en', path)}`} />
    <meta name="description" content={description ?? t.description} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={lang === 'ar' ? plexUrl : interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" hreflang="ar" href={href('ar', path)} />
    <link rel="alternate" hreflang="en" href={href('en', path)} />
    <slot name="head" />
    {path === '' && <script type="application/ld+json" is:inline set:html={clinicJsonLd} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    {!bare && (
      <>
        <div class="topbar">
          <div class="container">
            <a href={href(lang, 'clinic')}>{t.topbar.contact}</a>
            <a class="lang" href={altHref(lang, path)} hreflang={lang === 'ar' ? 'en' : 'ar'} lang={lang === 'ar' ? 'en' : 'ar'}>{t.switchLabel}</a>
          </div>
        </div>
        <header class="site-header">
          <div class="container">
            <Brand sub={t.brandSub} href={href(lang, '')} />
            <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>{t.menu}</button>
            <nav id="site-nav" class="nav" aria-label={lang === 'ar' ? 'القائمة الرئيسية' : 'Main'} data-nav>
              <ul>
                {links.map((l) => <li><a href={l.to} aria-current={current === l.to ? 'page' : undefined}>{l.label}</a></li>)}
              </ul>
              <a class="btn btn--solid" href={href(lang, 'appointments')} aria-current={path === 'appointments' ? 'page' : undefined}>{t.book}</a>
            </nav>
          </div>
        </header>
      </>
    )}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && path !== 'appointments' && (
      <nav class="mbar" aria-label={lang === 'ar' ? 'إجراءات سريعة' : 'Quick actions'}>
        <a class="mbar__book" href={href(lang, 'appointments')}>{t.book}</a>
        <a class="mbar__contact" href={href(lang, 'clinic')}>{lang === 'ar' ? 'تواصل' : 'Contact'}</a>
      </nav>
    )}
    {!bare && (
      <footer class="site-footer">
        <div class="container">
          <div class="top">
            <Brand sub={t.brandSub} href={href(lang, '')} />
            <nav aria-label={lang === 'ar' ? 'روابط قانونية' : 'Legal'}>
              <a href={href(lang, 'terms')}>{t.footer.terms}</a>
              <a href={href(lang, 'privacy')}>{t.footer.privacy}</a>
              <a href={href(lang, 'cookies')}>{t.footer.cookies}</a>
              <a href={href(lang, 'refunds')}>{t.footer.refunds}</a>
              <a href={href(lang, 'clinic')}>{t.footer.clinic}</a>
            </nav>
          </div>
          <ul class="socials" aria-label={lang === 'ar' ? 'حسابات التواصل الاجتماعي' : 'Social media'}>
            {socialLinks.map((l) => (
              <li><a href={l.url} target="_blank" rel="noopener me" aria-label={l.name}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={ICONS[l.name]} /></a></li>
            ))}
          </ul>
          <div class="info">
            {t.footer.pending && <p>{t.footer.pending}</p>}
            {t.footer.review && <p>{t.footer.review}</p>}
            <p>© 2026 Osman Uroclinic. {t.footer.rights}</p>
          </div>
        </div>
      </footer>
    )}
    <script>
      import '../lib/attribution';
      import '../scripts/motion';
      const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      const close = () => { nav?.classList.remove('is-open'); btn?.setAttribute('aria-expanded', 'false'); };
      btn?.addEventListener('click', () => {
        const open = !nav?.classList.contains('is-open');
        nav?.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { close(); btn.focus(); } });
    </script>
  </body>
</html>
