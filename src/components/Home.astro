---
import Base from '../layouts/Base.astro';
import YouTube from './YouTube.astro';
import { videos } from '../content/videos';
import { testimonials, whoLabel } from '../content/testimonials';
import { href, ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const ar = lang === 'ar';
const h = (to: string) => href(lang, to);
const lead = testimonials[1];
const more = [testimonials[0], testimonials[2]];
const vid = videos[0];

const c = ar
  ? {
      h1: 'استشارات المسالك البولية مع أ.د. طارق عثمان',
      sub: 'أستاذ ورئيس قسم جراحة المسالك البولية بكلية الطب، جامعة عين شمس.',
      contact: 'تواصل مع العيادة',
      facts: [
        ['رئيس قسم المسالك البولية', 'جامعة عين شمس، منذ 2024'],
        ['رئيس وحدة أورام المسالك البولية', 'جامعة عين شمس، منذ 2017'],
        ['24 بحثًا منشورًا', 'في مجلات علمية محكّمة'],
        ['استشاري في 5 مستشفيات', 'منها كليوباترا والسعودي الألماني'],
      ],
      aboutH: 'عن أ.د. طارق عثمان',
      aboutP: 'يعمل أ.د. طارق عثمان في جراحة المسالك البولية منذ تخرّجه في طب عين شمس عام 1990، وتلقّى تدريبًا متخصصًا في كامبريدج وجامعة واشنطن وجامعة نيم. يرأس قسم الأورام بالجمعية المصرية لجراحة المسالك البولية، وهو جرّاح روبوت معتمد.',
      aboutP2: 'يقول مرضاه إن أكثر ما يميّزه أنه يستمع أولًا، ثم يشرح الخيارات بلغة واضحة.',
      aboutCta: 'السيرة المهنية كاملة',
      treatH: 'ما يعالجه',
      treat: [
        ['صحة البروستاتا', 'تضخم البروستاتا الحميد والتهاباتها وأعراض التبول المرتبطة بها.', 'treatments/prostate-health'],
        ['أورام المسالك البولية', 'أورام البروستاتا والمثانة والكلى، من التشخيص إلى الجراحة.', 'treatments/urological-cancer'],
        ['الكلى والحصوات', 'حصوات الكلى والحالب، وانسداد مجرى البول، وسلس البول.', 'treatments/kidney-urinary-care'],
        ['الرأي الثاني', 'مراجعة تشخيص أو خطة علاج حالية قبل أن تقرر.', 'treatments/second-opinion'],
      ],
      more: 'اقرأ المزيد',
      vidH: 'شاهد أ.د. طارق يشرح',
      vidP: 'فيديوهات قصيرة عن الحالات الشائعة وطرق علاجها.',
      vidCta: 'كل الفيديوهات',
      wordsH: 'من رسائل المرضى',
      wordsCta: `اقرأ الرسائل الـ${testimonials.length}`,
      intlH: 'للمرضى القادمين من خارج مصر',
      intlP: 'تواصل مع العيادة قبل ترتيب السفر لتأكيد الموعد والفرع، ولمعرفة طريقة إرسال تقاريرك مسبقًا.',
      intlCta: 'المرضى الدوليون',
      bookH: 'احجز موعدك',
      bookP: 'اختر الفرع واليوم والوقت المناسب. تتواصل معك العيادة لتأكيد الحجز.',
    }
  : {
      h1: 'Urology consultations with Prof. Dr. Tarek Osman',
      sub: 'Professor and Head of the Urology Department, Faculty of Medicine, Ain Shams University.',
      contact: 'Contact the clinic',
      facts: [
        ['Head of Urology', 'Ain Shams University, since 2024'],
        ['Chairman, GU Oncology Unit', 'Ain Shams University, since 2017'],
        ['24 published papers', 'In peer-reviewed urology journals'],
        ['Consultant at 5 hospitals', 'Including Cleopatra and Saudi German'],
      ],
      aboutH: 'About Prof. Dr. Tarek Osman',
      aboutP: 'Prof. Tarek Osman has practised urology since graduating from Ain Shams in 1990, with specialist training in Cambridge, Washington University and Nîmes. He is President of the Uro-Oncology Section of the Egyptian Urologic Association and a certified robotic surgeon.',
      aboutP2: 'His patients most often mention one thing: he listens first, then explains the options in plain language.',
      aboutCta: 'Read his full profile',
      treatH: 'What he treats',
      treat: [
        ['Prostate health', 'Benign enlargement, prostatitis and the urinary symptoms that come with them.', 'treatments/prostate-health'],
        ['Urological cancer', 'Prostate, bladder and kidney cancer, from diagnosis to surgery.', 'treatments/urological-cancer'],
        ['Kidney and stones', 'Kidney and ureteric stones, urinary blockage and incontinence.', 'treatments/kidney-urinary-care'],
        ['Second opinions', 'A review of an existing diagnosis or treatment plan before you decide.', 'treatments/second-opinion'],
      ],
      more: 'Read more',
      vidH: 'Prof. Tarek explains',
      vidP: 'Short videos on common conditions and how they are treated.',
      vidCta: 'All videos',
      wordsH: 'From patients’ messages',
      wordsCta: `Read all ${testimonials.length} messages`,
      intlH: 'Travelling from outside Egypt',
      intlP: 'Contact the clinic before you make travel plans. We will confirm your appointment and branch, and tell you how to send your reports ahead of time.',
      intlCta: 'International patients',
      bookH: 'Book an appointment',
      bookP: 'Choose a branch, a day and a time. The clinic will contact you to confirm.',
    };
---

<Base lang={lang}>
<div class="rd">
  <section class="rd-hero">
    <div class="rd-hero__video hero-video">
      <video autoplay muted loop playsinline preload="auto" poster="/video/hero-poster.jpg" aria-hidden="true" disablepictureinpicture data-hero-video>
        <source media="(max-width: 700px)" src="/video/hero-m.mp4" type="video/mp4" />
        <source src="/video/hero.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="rd-wrap">
      <div class="rd-hero__panel">
        <h1>{c.h1}</h1>
        <p>{c.sub}</p>
        <div class="rd-actions">
          <a class="rd-btn" href={h('appointments')}>{t.book}</a>
          <a class="rd-link" href={h('clinic')}>{c.contact}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="rd-wrap rd-facts" aria-label={ar ? 'حقائق' : 'Credentials'}>
    {c.facts.map(([a, b]) => <div><p class="rd-facts__a">{a}</p><p>{b}</p></div>)}
  </section>

  <section class="rd-wrap rd-about">
    <figure class="rd-about__photo">
      <picture><source srcset="/photos/doctor.webp" type="image/webp" /><img src="/photos/doctor.jpg" alt={ar ? 'أ.د. طارق عثمان' : 'Prof. Dr. Tarek Osman'} width="1400" height="1400" loading="lazy" decoding="async" /></picture>
    </figure>
    <div class="rd-about__copy">
      <h2>{c.aboutH}</h2>
      <p>{c.aboutP}</p>
      <p class="rd-about__note">{c.aboutP2}</p>
      <a class="rd-link" href={h('about')}>{c.aboutCta}</a>
    </div>
  </section>

  <section class="rd-wrap rd-treat">
    <h2>{c.treatH}</h2>
    <div class="rd-treat__grid">
      {c.treat.map(([title, text, to]) => (
        <a class="rd-treat__item" href={h(to)}>
          <h3>{title}</h3>
          <p>{text}</p>
          <span class="rd-link">{c.more}</span>
        </a>
      ))}
    </div>
  </section>

  {vid && (
    <section class="rd-video">
      <div class="rd-wrap rd-video__in">
        <div class="rd-video__player"><YouTube video={vid} lang={lang} /></div>
        <div class="rd-video__copy">
          <h2>{c.vidH}</h2>
          <p>{c.vidP}</p>
          <p class="rd-video__title">{vid.title[lang]}</p>
          <a class="rd-link" href={h('videos')}>{c.vidCta}</a>
        </div>
      </div>
    </section>
  )}

  <section class="rd-wrap rd-words">
    <h2>{c.wordsH}</h2>
    <div class="rd-words__grid">
      <figure class="rd-words__lead">
        <blockquote><p>{lead[lang]}</p></blockquote>
        <figcaption>{whoLabel[lead.who][lang]}</figcaption>
      </figure>
      <div class="rd-words__more">
        {more.map((x) => <figure><blockquote><p>{x[lang]}</p></blockquote><figcaption>{whoLabel[x.who][lang]}</figcaption></figure>)}
        <a class="rd-link" href={h('patient-stories')}>{c.wordsCta}</a>
      </div>
    </div>
  </section>

  <section class="rd-wrap rd-intl">
    <div class="rd-intl__map"><img src="/world-map.svg" alt="" width="960" height="470" loading="lazy" decoding="async" /></div>
    <div class="rd-intl__copy">
      <h2>{c.intlH}</h2>
      <p>{c.intlP}</p>
      <a class="rd-btn rd-btn--ghost" href={h('international-patients')}>{c.intlCta}</a>
    </div>
  </section>

  <section class="rd-wrap">
    <div class="rd-book">
      <div>
        <h2>{c.bookH}</h2>
        <p>{c.bookP}</p>
      </div>
      <a class="rd-btn" href={h('appointments')}>{t.book}</a>
    </div>
  </section>
</div>
</Base>

<script>
  import '../scripts/hero-video';
</script>
