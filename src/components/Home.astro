---
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/noto-naskh-arabic/arabic-400.css';
import Base from '../layouts/Base.astro';
import { videos } from '../content/videos';
import { testimonials, whoLabel } from '../content/testimonials';
import { href, ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const ar = lang === 'ar';
const h = (to: string) => href(lang, to);
const q = (s: string) => (ar ? `«${s}»` : `“${s}”`);
const quotes = testimonials.filter((x) => x.quote).slice(0, 3);
const vid = videos[0];

const c = ar
  ? {
      h1: 'رعاية متخصصة في المسالك البولية، بشرح واضح',
      meetLink: 'تعرّف على أ.د. طارق عثمان',
      find: 'ابحث عن الرعاية حسب الحالة',
      chips: [['البروستاتا', 'treatments/prostate-health'], ['المثانة', 'treatments/urological-cancer'], ['حصوات الكلى', 'treatments/kidney-urinary-care'], ['الأورام', 'treatments/urological-cancer'], ['سلس البول', 'treatments/kidney-urinary-care'], ['صحة الرجل', 'treatments/prostate-health'], ['الأطفال', 'videos'], ['رأي ثانٍ', 'treatments/second-opinion']],
      searchLabel: 'ابحث في الحالات والعلاجات',
      searchPh: 'مثال: البروستاتا، الحصوات',
      searchGo: 'بحث',
      noMatch: 'لم نجد نتيجة. جرّب كلمة أخرى أو تصفّح المجالات أدناه.',
      s1: 'الرعاية تبدأ بالاستماع',
      s1a: 'أستاذ ورئيس قسم المسالك البولية، جامعة عين شمس',
      s1at: 'يرأس أ.د. طارق عثمان قسم المسالك البولية ووحدة أورام المسالك البولية والتناسلية، وتلقى تدريبًا متخصصًا في المملكة المتحدة والولايات المتحدة وفرنسا.',
      s1b: 'أبحاث وراء كل توصية',
      s1bt: '24 بحثًا محكّمًا في أمراض البروستاتا والحصوات وأورام المسالك البولية.',
      s1link: 'اطّلع على أبحاثه',
      s1cta: 'عن أ.د. طارق',
      s2: 'رعاية للمرضى القادمين من الخارج',
      s2t: 'نسهّل على المرضى القادمين من الخليج وغيره ترتيب استشارتهم في القاهرة ومشاركة تقاريرهم قبل الوصول.',
      s2cta: 'المرضى الدوليون',
      areas: 'مجالات الرعاية',
      areasT: 'استشارات وتشخيص وجراحة في المسالك البولية وأورامها.',
      care: [['تضخم البروستاتا الحميد', 'treatments/prostate-health'], ['سرطان البروستاتا', 'treatments/urological-cancer'], ['سرطان المثانة', 'treatments/urological-cancer'], ['سرطان الكلى', 'treatments/urological-cancer'], ['حصوات الكلى والحالب', 'treatments/kidney-urinary-care'], ['سلس البول', 'treatments/kidney-urinary-care'], ['مسالك بولية السيدات', 'treatments/kidney-urinary-care'], ['الجراحة بالروبوت والمنظار', 'about'], ['جراحات إعادة البناء', 'about'], ['الرأي الثاني', 'treatments/second-opinion']],
      voices: 'بكلمات المرضى',
      voicesCta: `اقرأ الرسائل كلها (${testimonials.length})`,
      vids: 'فيديوهات',
      vidsT: 'شروحات قصيرة من أ.د. طارق عن الحالات الشائعة وطرق علاجها.',
      vidsCta: 'كل الفيديوهات',
      vidSub: 'أحدث فيديو',
      res: 'الأبحاث والنشاط العلمي',
      resSub: 'الأبحاث المنشورة والمؤتمرات',
      band: 'جاهز لترتيب استشارتك؟',
      bandT: 'اختر الفرع والموعد المناسبين، وتتواصل معك العيادة للتأكيد.',
    }
  : {
      h1: 'Expert urology care, explained clearly',
      meetLink: 'Meet Prof. Dr. Tarek Osman',
      find: 'Find care by condition',
      chips: [['Prostate', 'treatments/prostate-health'], ['Bladder', 'treatments/urological-cancer'], ['Kidney stones', 'treatments/kidney-urinary-care'], ['Cancer', 'treatments/urological-cancer'], ['Incontinence', 'treatments/kidney-urinary-care'], ['Men’s health', 'treatments/prostate-health'], ['Children', 'videos'], ['Second opinion', 'treatments/second-opinion']],
      searchLabel: 'Search conditions & treatments',
      searchPh: 'e.g. prostate, stones',
      searchGo: 'Search',
      noMatch: 'No match found. Try another word or browse the care areas below.',
      s1: 'Care starts with listening',
      s1a: 'Head of Urology, Ain Shams University',
      s1at: 'Prof. Dr. Tarek Osman leads the Urology Department and chairs its GU Oncology Unit, with specialist training in the UK, US and France.',
      s1b: 'Research behind every recommendation',
      s1bt: '24 peer-reviewed papers on prostate disease, stones and urological cancer.',
      s1link: 'See his research',
      s1cta: 'About Prof. Tarek',
      s2: 'Care for patients from abroad',
      s2t: 'We make it easy for patients travelling from the Gulf and beyond to plan a consultation in Cairo and share reports before they arrive.',
      s2cta: 'International patients',
      areas: 'Featured care areas',
      areasT: 'Consultations, diagnosis and surgery across urology and uro-oncology.',
      care: [['Prostate enlargement (BPH)', 'treatments/prostate-health'], ['Prostate cancer', 'treatments/urological-cancer'], ['Bladder cancer', 'treatments/urological-cancer'], ['Kidney cancer', 'treatments/urological-cancer'], ['Kidney & ureteric stones', 'treatments/kidney-urinary-care'], ['Urinary incontinence', 'treatments/kidney-urinary-care'], ['Female urology', 'treatments/kidney-urinary-care'], ['Robotic & laparoscopic surgery', 'about'], ['Reconstructive urology', 'about'], ['Second opinions', 'treatments/second-opinion']],
      voices: 'In patients’ words',
      voicesCta: `Read all ${testimonials.length} messages`,
      vids: 'Videos',
      vidsT: 'Short explanations from Prof. Tarek on common conditions and how they are treated.',
      vidsCta: 'All videos',
      vidSub: 'Latest video',
      res: 'Research & scientific work',
      resSub: 'Publications and meetings',
      band: 'Ready to plan your consultation?',
      bandT: 'Choose the branch and time that suit you. The clinic will contact you to confirm.',
    };
const index = [...c.chips, ...c.care].map(([label, to]) => ({ label, to: h(to) }));
---

<Base lang={lang}>
<div class="mh">
  <section class="mh-hero">
    <div class="mh-hero__media hero-video">
      <video autoplay muted loop playsinline preload="auto" poster="/video/hero-poster.jpg" aria-hidden="true" disablepictureinpicture data-hero-video>
        <source media="(max-width: 700px)" src="/video/hero-m.mp4" type="video/mp4" />
        <source src="/video/hero.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="mh-shade"></div>
    <div class="mh-wrap mh-hero__in">
      <h1>{c.h1}</h1>
      <div class="mh-hero__row">
        <a class="mh-txt" href={h('about')}>{c.meetLink} <span aria-hidden="true">›</span></a>
        <a class="mh-pill mh-pill--light" href={h('appointments')}>{t.book}</a>
      </div>
    </div>
  </section>

  <section class="mh-wrap mh-find">
    <div>
      <h2>{c.find}</h2>
      <ul class="mh-chips">{c.chips.map(([l, to]) => <li><a href={h(to)}>{l}</a></li>)}</ul>
    </div>
    <form class="mh-search" role="search" data-care-search data-index={JSON.stringify(index)}>
      <label for="care-q">{c.searchLabel}</label>
      <div class="mh-box">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
        <input id="care-q" name="q" type="search" placeholder={c.searchPh} list="care-list" autocomplete="off" />
        <button type="submit">{c.searchGo}</button>
      </div>
      <datalist id="care-list">{index.map((i) => <option value={i.label} />)}</datalist>
      <p class="mh-nomatch" data-nomatch hidden>{c.noMatch}</p>
    </form>
  </section>

  <div class="mh-wrap"><hr class="mh-hr" /></div>

  <section class="mh-wrap mh-split">
    <div class="mh-copy">
      <h2>{c.s1}</h2>
      <h3>{c.s1a}</h3>
      <p>{c.s1at}</p>
      <h3>{c.s1b}</h3>
      <p>{c.s1bt} <a href={h('research')}>{c.s1link}</a></p>
      <a class="mh-pill" href={h('about')}>{c.s1cta}</a>
    </div>
    <figure class="mh-pic mh-pic--tall">
      <picture><source srcset="/photos/doctor.webp" type="image/webp" /><img src="/photos/doctor.jpg" alt={ar ? 'أ.د. طارق عثمان' : 'Prof. Dr. Tarek Osman'} width="1400" height="1400" loading="lazy" decoding="async" /></picture>
    </figure>
  </section>

  <section class="mh-wrap mh-split mh-split--rev">
    <figure class="mh-pic mh-pic--wide">
      <picture><source srcset="/photos/consult-room.webp" type="image/webp" /><img src="/photos/consult-room.jpg" alt={ar ? 'غرفة الكشف في العيادة' : 'The consultation room'} width="1086" height="724" loading="lazy" decoding="async" /></picture>
    </figure>
    <div class="mh-copy">
      <h2>{c.s2}</h2>
      <p>{c.s2t}</p>
      <a class="mh-pill" href={h('international-patients')}>{c.s2cta}</a>
    </div>
  </section>

  <section class="mh-wrap mh-areas" id="care-areas">
    <div><h2>{c.areas}</h2><p>{c.areasT}</p></div>
    <ul>{c.care.map(([l, to]) => <li><a href={h(to)}>{l}<span aria-hidden="true">›</span></a></li>)}</ul>
  </section>

  <section class="mh-voices">
    <div class="mh-wrap">
      <h2>{c.voices}</h2>
      <div class="mh-q3">{quotes.map((x) => <figure><blockquote><p>{q(x.quote![lang])}</p></blockquote><figcaption>{whoLabel[x.who][lang]}</figcaption></figure>)}</div>
      <a class="mh-txt mh-txt--dark" href={h('patient-stories')}>{c.voicesCta} <span aria-hidden="true">›</span></a>
    </div>
  </section>

  <section class="mh-wrap mh-media">
    <div><h2>{c.vids}</h2><p>{c.vidsT}</p><a class="mh-pill" href={h('videos')}>{c.vidsCta}</a></div>
    {vid && (
      <a class="mh-card mh-card--big" href={h('videos')}>
        <img src={`https://i.ytimg.com/vi/${vid.id}/maxresdefault.jpg`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
        <span class="mh-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
        <span class="mh-cap"><b>{vid.title[lang]}</b>{c.vidSub}</span>
      </a>
    )}
    <a class="mh-card" href={h('research')}>
      <picture><source srcset="/photos/certificates.webp" type="image/webp" /><img src="/photos/certificates.jpg" alt="" width="1448" height="740" loading="lazy" decoding="async" /></picture>
      <span class="mh-cap"><b>{c.res}</b>{c.resSub}</span>
    </a>
  </section>

  <section class="mh-band">
    <div class="mh-wrap mh-band__in">
      <h2>{c.band}</h2>
      <p>{c.bandT}</p>
      <a class="mh-pill mh-pill--solid" href={h('appointments')}>{t.book}</a>
    </div>
  </section>
</div>
</Base>

<script>
  import '../scripts/hero-video';
  import '../scripts/care-search';
</script>
