---
import { href, type Lang } from '../i18n/ui';
import { profile, sections, publications } from '../content/doctor';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const s = ar
  ? { book: 'احجز موعدك', pubs: 'الأبحاث المنشورة', jump: 'في هذه الصفحة', research: 'الأبحاث المنشورة', researchText: `${publications.length} بحثًا في مجلات علمية محكّمة، من 2003 حتى 2026، في أورام المسالك البولية والحصوات والبروستاتا ومسالك السيدات.`, researchCta: 'تصفّح الأبحاث', consultant: 'استشاري المسالك البولية' }
  : { book: 'Book your appointment', pubs: 'Publications', jump: 'On this page', research: 'Published research', researchText: `${publications.length} peer-reviewed papers from 2003 to 2026 across uro-oncology, stone disease, prostate health and female urology.`, researchCta: 'Browse the publications', consultant: 'Consultant urologist' };
const alt = ar ? 'أ.د. طارق عثمان، أستاذ ورئيس قسم جراحة المسالك البولية بجامعة عين شمس' : 'Prof. Dr. Tarek Osman, Professor and Head of Urology at Ain Shams University';
const acr = (t: string) => (t.match(/\(([A-Z]{2,6})\)/) || [])[1];
const strip = (t: string) => t.replace(/\s*\([A-Z]{2,6}\)\s*/, '');
const variant: Record<string, string> = { positions: 'rows', hospitals: 'tiles', interests: 'tiles', qualifications: 'timeline', training: 'tiles', memberships: 'badges', academic: 'rows', community: 'rows' };
---

<section class="pf-hero">
  <figure class="pf-hero__photo">
    <picture>
      <source srcset="/photos/doctor.webp" type="image/webp" />
      <img src="/photos/doctor.jpg" alt={alt} width="1400" height="1400" fetchpriority="high" decoding="async" />
    </picture>
  </figure>
  <div class="pf-hero__shade"></div>
  <div class="hx-wrap pf-hero__in">
    <div class="pf-hero__copy">
      <h1>{profile.name[lang]}</h1>
      <p class="pf-role">{profile.role[lang]}</p>
      <p class="pf-bio">{profile.bio[lang]}</p>
      <div class="hx-actions">
        <a class="hx-pill hx-pill--solid" href={href(lang, 'appointments')}>{s.book}</a>
        <a class="hx-pill hx-pill--ghost" href={href(lang, 'research')}>{s.pubs}</a>
      </div>
    </div>
    <dl class="pf-facts">
      {profile.facts.map((f) => <div><dt>{f.value}</dt><dd>{f.label[lang]}</dd></div>)}
    </dl>
  </div>
</section>

<nav class="pf-nav" aria-label={s.jump} data-pf-nav>
  <div class="hx-wrap"><ul>{sections.map((sec) => <li><a href={`#${sec.id}`}>{sec.heading[lang]}</a></li>)}</ul></div>
</nav>

<div class="hx-wrap pf-body">
  {sections.map((sec) => (
    <section id={sec.id} class:list={['pf-sec', `pf-sec--${variant[sec.id] || 'rows'}`]}>
      <h2>{sec.heading[lang]}</h2>
      <div class="pf-sec__body">
        {variant[sec.id] === 'badges' ? (
          <ul class="pf-badges">{sec.items.map((it) => <li><strong dir="ltr">{acr(it.title.en) || ''}</strong><span>{strip(it.title[lang])}</span></li>)}</ul>
        ) : variant[sec.id] === 'timeline' ? (
          <ol class="pf-timeline">{sec.items.map((it) => (
            <li><span class="pf-year" dir="ltr">{it.years}</span><div><p class="pf-t">{it.title[lang]}</p>{it.detail?.[lang] && <p class="pf-d">{it.detail[lang]}</p>}</div></li>
          ))}</ol>
        ) : variant[sec.id] === 'tiles' ? (
          <ul class="pf-tiles">{sec.items.map((it) => (
            <li><p class="pf-t">{it.title[lang]}</p><p class="pf-d">{it.detail?.[lang] || (sec.id === 'hospitals' ? s.consultant : '')}</p></li>
          ))}</ul>
        ) : (
          <ul class="pf-rows">{sec.items.map((it) => (
            <li><div><p class="pf-t">{it.title[lang]}</p>{it.detail?.[lang] && <p class="pf-d">{it.detail[lang]}</p>}</div>{it.years && <span class="pf-year" dir="ltr">{it.years}</span>}</li>
          ))}</ul>
        )}
      </div>
    </section>
  ))}
  <section class="pf-research">
    <div>
      <h2>{s.research}</h2>
      <p>{s.researchText}</p>
    </div>
    <a class="hx-pill hx-pill--light" href={href(lang, 'research')}>{s.researchCta}</a>
  </section>
</div>

<script>
  const nav = document.querySelector<HTMLElement>('[data-pf-nav]');
  if (nav) {
    const links = new Map(Array.from(nav.querySelectorAll<HTMLAnchorElement>('a')).map((a) => [a.getAttribute('href')!.slice(1), a]));
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) {
        links.forEach((a) => a.removeAttribute('aria-current'));
        const a = links.get(e.target.id);
        if (a) { a.setAttribute('aria-current', 'true'); a.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' }); }
      }
    }, { rootMargin: '-40% 0px -55% 0px' });
    links.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
  }
</script>
