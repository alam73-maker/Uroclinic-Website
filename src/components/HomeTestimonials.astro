---
import { href, type Lang } from '../i18n/ui';
import { testimonials, whoLabel, themes } from '../content/testimonials';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const q = (s: string) => (ar ? `«${s}»` : `“${s}”`);
const quoted = testimonials.filter((t) => t.quote);
const short = testimonials.filter((t) => !t.quote).sort((a, b) => a.en.length - b.en.length).slice(0, 3);
const picks = [quoted[0], short[0], quoted[1], short[1], quoted[2], short[2], ...quoted.slice(3)].filter(Boolean);
const theme = Object.fromEntries(themes.map((t) => [t.id, t.title[lang]]));
const s = ar
  ? { h: 'بكلمات المرضى وأسرهم', p: `${testimonials.length} رسالة شكر أرسلها المرضى وأسرهم إلى العيادة.`, cta: 'اقرأ كل الرسائل', prev: 'السابق', next: 'التالي' }
  : { h: 'In the words of patients and families', p: `${testimonials.length} thank-you messages sent to the clinic by patients and their families.`, cta: 'Read all messages', prev: 'Previous', next: 'Next' };
---

<section class="tq-home">
  <div class="hx-wrap tq-home__head">
    <div>
      <h2>{s.h}</h2>
      <p>{s.p}</p>
    </div>
    <div class="tq-home__ctl">
      <a class="hx-pill tq-pill" href={href(lang, 'patient-stories')}>{s.cta}</a>
      <button type="button" class="tq-arrow" data-tq="-1" aria-label={s.prev}><svg viewBox="0 0 24 24" width="18" height="18"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button type="button" class="tq-arrow" data-tq="1" aria-label={s.next}><svg viewBox="0 0 24 24" width="18" height="18"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
  </div>
  <div class="tq-track" data-tq-track tabindex="0">
    {picks.map((t) => (
      <figure class:list={['tq-card', { 'tq-card--q': t.quote }]}>
        {t.quote && <p class="tq-pull">{q(t.quote[lang])}</p>}
        <blockquote><p>{t[lang]}</p></blockquote>
        <figcaption><span class="tq-av" aria-hidden="true">{t.who === 'family' ? (ar ? 'أ' : 'F') : (ar ? 'م' : 'P')}</span><span><b>{whoLabel[t.who][lang]}</b><small>{theme[t.theme]}</small></span></figcaption>
      </figure>
    ))}
  </div>
</section>

<script>
  import '../scripts/tq';
</script>
