---
import Base from '../layouts/Base.astro';
import { href, ui, type Lang } from '../i18n/ui';
import { topics, type ContentPage } from '../content/pages';
import { physicianJsonLd } from '../content/doctor';
import DoctorProfile from './DoctorProfile.astro';
import Publications from './Publications.astro';
import YouTube from './YouTube.astro';
import Testimonials from './Testimonials.astro';
import { videos } from '../content/videos';

interface Props { lang: Lang; page: ContentPage }
const { lang, page } = Astro.props;
const t = ui[lang];
const p = page[lang];
const figures: Record<string, { src: string; w: number; h: number; alt: Record<Lang, string> }> = {
  research: { src: '/photos/certificates', w: 1448, h: 740, alt: { ar: 'شهادات أ.د. طارق عثمان من مؤتمرات المسالك البولية معلّقة على جدار العيادة', en: 'Prof. Dr. Tarek Osman’s certificates from urology meetings, framed on the clinic wall' } },
  'patient-stories': { src: '/photos/consult-room', w: 1086, h: 724, alt: { ar: 'غرفة الكشف في عيادة أ.د. طارق عثمان', en: 'The consultation room at Prof. Dr. Tarek Osman’s clinic' } },
};
const fig = figures[page.slug];
---

<Base lang={lang} path={page.slug} title={p.title} description={p.lead || undefined}>
  {page.slug === 'about' && <script type="application/ld+json" is:inline set:html={physicianJsonLd} slot="head" />}
  {page.slug === 'about' ? <DoctorProfile lang={lang} /> : (
  <section class:list={['page-intro', { 'page-intro--media': !!fig }]}>
    <div class="container">
      <div>
        <h1>{p.title}</h1>
        {p.lead && <p>{p.lead}</p>}
        {page.legal && <p class="draft">{t.reviewDraft}</p>}
      </div>
      {fig && (
        <figure class="page-figure">
          <picture>
            <source srcset={`${fig.src}.webp`} type="image/webp" />
            <img src={`${fig.src}.jpg`} alt={fig.alt[lang]} width={fig.w} height={fig.h} decoding="async" fetchpriority="high" />
          </picture>
        </figure>
      )}
    </div>
  </section>
  )}
  {page.slug === 'about' ? null : page.slug === 'research' ? <Publications lang={lang} /> : page.slug === 'patient-stories' ? <Testimonials lang={lang} /> : page.slug === 'videos' ? (
    <div class="container video-grid">{videos.map((v) => <article class="video-card"><YouTube video={v} lang={lang} /><h2>{v.title[lang]}</h2></article>)}</div>
  ) : page.slug === 'treatments' ? (
    <section class="topic-rows">
      <div class="container">
        {topics.map((tp) => (
          <a class="topic-row" href={href(lang, `treatments/${tp.slug}`)}>
            <h2>{tp[lang][0]}</h2>
            <p>{tp[lang][1]}</p>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  ) : (
    <div class="container"><div class="prose" set:html={p.body} /></div>
  )}
  {page.closing && (
    <section class="closing">
      <div class="container">
        <h2>{t.closing.title}</h2>
        <p>{t.closing.text}</p>
        <a class="btn btn--light" href={href(lang, 'appointments')}>{t.closing.cta}</a>
      </div>
    </section>
  )}
</Base>
