---
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '@fontsource/noto-naskh-arabic/arabic-400.css';
import type { Lang } from '../i18n/ui';
import { testimonials, whoLabel, type Testimonial } from '../content/testimonials';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const q = (s: string) => (ar ? `«${s}»` : `“${s}”`);
const big = testimonials.filter((t) => t.quote);
const rest = testimonials.filter((t) => !t.quote);
const wall: Testimonial[] = [];
rest.forEach((t, i) => {
  if (i % 9 === 0 && big[i / 9]) wall.push(big[i / 9]);
  wall.push(t);
});
const note = ar
  ? 'رسائل أرسلها المرضى وأسرهم إلى العيادة، ننشرها دون أسماء. تجربة كل مريض فردية.'
  : 'Messages sent to the clinic by patients and their families, shared without names. Every patient’s experience is individual.';
---

<div class="container tm-wall">
  {wall.map((t) => (
    <figure class:list={['tm-q', { 'tm-q--big': t.quote }]}>
      {t.quote && <p class="tm-q__pull">{q(t.quote[lang])}</p>}
      <blockquote><p>{t[lang]}</p></blockquote>
      <figcaption class="tm-by">— {whoLabel[t.who][lang]}</figcaption>
    </figure>
  ))}
</div>
<div class="container"><p class="tm-note">{note}</p></div>
