---
interface Props { name: 'doctor' | 'globe' | 'stethoscope' | 'quote' | 'book' }
const { name } = Astro.props;
---

<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'quote' && (
    <>
      <path d="M8 10h32a2 2 0 0 1 2 2v20a2 2 0 0 1-2 2H22l-9 7v-7H8a2 2 0 0 1-2-2V12a2 2 0 0 1 2-2z" />
      <path d="M17 19h-2v5h4v-2M27 19h-2v5h4v-2" />
    </>
  )}
  {name === 'book' && (
    <>
      <path d="M24 12c-4-3-10-4-16-3v28c6-1 12 0 16 3 4-3 10-4 16-3V9c-6-1-12 0-16 3z" />
      <path d="M24 12v28M13 17h6M13 23h6M29 17h6M29 23h6" />
    </>
  )}
  {name === 'doctor' && (
    <>
      <path d="M16 12a8 8 0 0 1 16 0v4a8 8 0 0 1-16 0z" />
      <path d="M16 12h16M24 6v4M22 8h4" />
      <path d="M8 44v-4c0-7 6-12 16-12s16 5 16 12v4" />
      <path d="M18 29l6 7 6-7M30 36h6v6h-6z" />
    </>
  )}
  {name === 'globe' && (
    <>
      <circle cx="24" cy="24" r="17" />
      <path d="M7 24h34M24 7c5 5 7 11 7 17s-2 12-7 17c-5-5-7-11-7-17s2-12 7-17z" />
    </>
  )}
  {name === 'stethoscope' && (
    <>
      <path d="M12 6v12a8 8 0 0 0 16 0V6" />
      <path d="M20 26v6a8 8 0 0 0 16 0v-4" />
      <circle cx="36" cy="24" r="4" />
      <path d="M9 6h6M25 6h6" />
    </>
  )}
</svg>
