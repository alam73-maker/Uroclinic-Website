---
import { href, type Lang } from '../i18n/ui';
import { pages } from '../content/pages';
import { publications, meetings } from '../content/doctor';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const page = pages.find((p) => p.slug === 'research')![lang];
const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const journals = new Set(publications.map((p) => p.journal)).size;
const first = Math.min(...years);
const last = Math.max(...years);
const area = (t: string) =>
  /cancer|oncolog|cystectomy|carcinoma|urothelial|diversion/i.test(t) ? 'onc'
  : /stone|lithotripsy|nephrolithotomy|ureteral stent/i.test(t) ? 'stone'
  : /incontinence|prolapse|women/i.test(t) ? 'female'
  : /prostat|tamsulosin|rezum|dutasteride/i.test(t) ? 'prostate'
  : 'recon';
const areas = ar
  ? [['all', 'الكل'], ['onc', 'أورام المسالك'], ['stone', 'الحصوات'], ['prostate', 'البروستاتا'], ['female', 'مسالك السيدات'], ['recon', 'الترميم وغيرها']]
  : [['all', 'All'], ['onc', 'Uro-oncology'], ['stone', 'Stones'], ['prostate', 'Prostate'], ['female', 'Female urology'], ['recon', 'Reconstructive & other']];
const meetYears = [...new Set(meetings.map((m) => m.date.slice(0, 4)))].sort().reverse();
const fmt = new Intl.DateTimeFormat(ar ? 'ar-EG-u-nu-latn' : 'en-GB', { month: 'short' });
const s = ar
  ? { book: 'احجز موعدك', about: 'عن الدكتور', papers: 'بحثًا محكّمًا', journals: 'مجلة علمية', span: 'سنوات من النشر', meets: 'مؤتمرًا وورشة عمل', pubs: 'الأبحاث المنشورة', pubsText: 'عناوين الأبحاث بلغة نشرها الأصلية.', filter: 'تصفية حسب المجال', open: 'اقرأ البحث', meet: 'أنشطة قسم أورام المسالك البولية', meetText: 'مؤتمرات وورش عمل علمية نظّمها قسم الأورام بالجمعية المصرية لجراحة المسالك البولية برئاسة أ.د. طارق عثمان.' }
  : { book: 'Book your appointment', about: 'About the doctor', papers: 'Peer-reviewed papers', journals: 'Journals', span: 'Years of publishing', meets: 'Section meetings and workshops', pubs: 'Publications', pubsText: 'Papers in international and regional urology journals, newest first.', filter: 'Filter by area', open: 'Read the paper', meet: 'Uro-Oncology Section activities', meetText: 'Scientific meetings and workshops organised by the Uro-Oncology Section of the Egyptian Urologic Association under Prof. Tarek Osman’s presidency.' };
---

<section class="rs-hero">
  <picture class="rs-hero__bg">
    <source srcset="/photos/certificates.webp" type="image/webp" />
    <img src="/photos/certificates.jpg" alt="" width="1448" height="740" fetchpriority="high" decoding="async" />
  </picture>
  <div class="rs-hero__shade"></div>
  <div class="hx-wrap rs-hero__in">
    <div class="rs-hero__copy">
      <h1>{page.title.replace(/\.$/, '')}</h1>
      <p>{page.lead}</p>
      <div class="hx-actions">
        <a class="hx-pill hx-pill--solid" href={href(lang, 'appointments')}>{s.book}</a>
        <a class="hx-pill hx-pill--ghost" href={href(lang, 'about')}>{s.about}</a>
      </div>
    </div>
    <dl class="pf-facts">
      <div><dt>{publications.length}</dt><dd>{s.papers}</dd></div>
      <div><dt>{journals}</dt><dd>{s.journals}</dd></div>
      <div><dt dir="ltr">{first}–{last}</dt><dd>{s.span}</dd></div>
      <div><dt>{meetings.length}</dt><dd>{s.meets}</dd></div>
    </dl>
  </div>
</section>

<section class="rs-pubs" aria-labelledby="pubs-h">
  <div class="hx-wrap rs-pubs__in">
    <header class="rs-pubs__head">
      <h2 id="pubs-h">{s.pubs}</h2>
      <p>{s.pubsText}</p>
    </header>
    <div class="rs-filter" role="group" aria-label={s.filter} data-rs-filter>
      {areas.map(([k, label], i) => <button type="button" data-area={k} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}
    </div>
    <div class="rs-list">
      {years.map((y) => (
        <div class="rs-year" data-rs-year>
          <h3>{y}</h3>
          <ol>
            {publications.filter((p) => p.year === y).map((p) => {
              const inner = (
                <>
                  <span class="rs-paper__t">{p.title}</span>
                  <span class="rs-paper__j">{p.journal}</span>
                  {p.url && <span class="rs-paper__go" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>}
                </>
              );
              return (
                <li data-area={area(p.title)}>
                  {p.url
                    ? <a class="rs-paper" href={p.url} rel="noopener" target="_blank" lang="en" dir="ltr" aria-label={`${s.open}: ${p.title}`}>{inner}</a>
                    : <div class="rs-paper" lang="en" dir="ltr">{inner}</div>}
                </li>
              );
            })}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="rs-meet" aria-labelledby="meet-h">
  <div class="hx-wrap">
    <header class="rs-meet__head">
      <h2 id="meet-h">{s.meet}</h2>
      <p>{s.meetText}</p>
    </header>
    <div class="rs-meet__grid">
      {meetYears.map((y) => (
        <div class="rs-meet__year">
          <h3>{y}</h3>
          <ul>
            {meetings.filter((m) => m.date.startsWith(y)).map((m) => (
              <li><time datetime={m.date}>{fmt.format(new Date(`${m.date}-01T12:00:00Z`))}</time><span lang="en" dir="ltr">{m.title}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import '../scripts/research';
</script>
